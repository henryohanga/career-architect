# Career Architect - Git Ignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
pip-log.txt

# Build artifacts
*.pdf
*.docx
*.aux
*.log
*.out
.last_build

# Showcase gallery outputs are intentionally tracked
!examples/showcase/**/*.pdf

# Demo mode state (see scripts/demo_mode.py)
source_materials/.backup/
.demo-active

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Blogs directory - keep untracked for publishing drafts
blogs/

# Keep applications structure but ignore generated files
# Uncomment below if you want to track application markdown but not outputs
# applications/**/*.pdf
# applications/**/*.docx
# applications/**/*.txt

# Claude Code local session state (personal, not for sharing)
.claude/settings.local.json
